{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Kotlin / KSP の更新をグループ化し、semanticCommitType を fix に設定",
  "packageRules": [
    {
      "description": "Kotlin と KSP の更新を 1 つの PR にまとめる",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin\\./",
        "/^org\\.jetbrains\\.kotlin:/",
        "/^com\\.google\\.devtools\\.ksp/"
      ],
      "groupName": "Kotlin",
      "semanticCommitType": "fix"
    }
  ]
}
