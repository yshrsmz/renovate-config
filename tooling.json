{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "開発ツール (aqua, mise) の管理ルール",
  "extends": ["github>aquaproj/aqua-renovate-config#2.12.0"],
  "packageRules": [
    {
      "description": "mise の依存更新をグループ化",
      "matchManagers": ["mise"],
      "groupName": "mise dependencies"
    },
    {
      "description": "aqua の依存更新をグループ化",
      "matchFileNames": [
        "**/.aqua.yaml",
        "**/.aqua.yml",
        "**/aqua.yaml",
        "**/aqua.yml"
      ],
      "groupName": "aqua dependencies"
    }
  ]
}
